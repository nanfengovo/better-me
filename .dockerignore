# Deny by default: never send the working tree, memory, browser profiles or exports.
**

!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!tsconfig.base.json

!config/geography/countries.json
!config/sources/catalog.json
!config/geography/china-administrative/catalog.json
!config/geography/china-administrative/source-manifest.json
!config/geography/china-administrative/text-aliases.json

!apps/web/package.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/tsconfig.node.json
!apps/web/vite.config.ts
!apps/web/src/**/*.ts
!apps/web/src/**/*.tsx
!apps/web/src/**/*.css
!apps/web/src/**/*.json
!apps/web/src/components/atlas/geo/world-countries-110m.geojson
!apps/web/src/components/atlas/geo/china-provinces-10m.geojson
!apps/web/src/components/atlas/geo/world-land-dots.geojson
!apps/web/src/components/atlas/geo/NOTICE.md
!apps/web/src/components/atlas/geo/NATURAL-EARTH-LICENSE.md
!apps/web/src/components/atlas/geo/README.md
!apps/web/src/components/atlas/geo/RENDERER-NOTES.md
!apps/web/src/components/atlas/geo/build-assets.py
!apps/web/src/components/atlas/geo/build-dots.py
!apps/web/src/components/atlas/geo/requirements-build.txt
!apps/web/server/**/*.ts
!apps/job-service/package.json
!apps/job-service/tsconfig.json
!apps/job-service/src/**/*.ts

!packages/core/package.json
!packages/core/tsconfig.json
!packages/core/src/**/*.ts
!packages/core/src/**/*.json
!packages/storage/package.json
!packages/storage/tsconfig.json
!packages/storage/src/**/*.ts
!packages/opportunities/package.json
!packages/opportunities/tsconfig.json
!packages/opportunities/src/**/*.ts
!packages/opportunities/src/**/*.json
!packages/source-adapters/package.json
!packages/source-adapters/tsconfig.json
!packages/source-adapters/src/**/*.ts
!packages/source-adapters/src/**/*.json

!templates/README.md
!templates/CATALOG.md
!templates/catalog.json
!templates/licenses/**/LICENSE
!templates/licenses/**/NOTICE.md
!templates/licenses/**/UPSTREAM_PACKAGE.json
!templates/licenses/**/UPSTREAM-ROOT-LICENSE

!docker/nginx.conf
!docker/mime.types
!docker/legal.html
!docker/collect-licenses.mjs
!docker/license-overrides/boolbase-1.0.0/LICENSE
!docker/license-overrides/boolbase-1.0.0/NOTICE.md

# Defence in depth if a private file is accidentally placed under an allowed source path.
**/node_modules/**
**/dist/**
**/.env
**/.env.*
**/*.private.*
**/*.personal.*
**/*.backup.json
**/better-me-backup-*.json
**/better-me-draft-*.json
**/better-me-opportunities*.json
**/better-me-material-*.md
**/better-me-rendercv-*.yaml
**/*-解析核对.json
**/*-extracted.txt
**/*-原文.txt
**/*-source.txt
