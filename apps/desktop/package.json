{
  "name": "@better-me/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "迈向更好 / BetterMe OS 桌面端应用",
  "main": "dist/main/index.cjs",
  "type": "module",
  "productName": "BetterMe",
  "author": "BetterMe contributors",
  "license": "UNLICENSED",
  "files": ["dist", "resources/icon.png"],
  "scripts": {
    "dev": "node --import tsx src/main/dev-runner.ts",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node22 --outfile=dist/main/index.cjs --format=cjs --external:electron",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node22 --outfile=dist/preload/index.cjs --format=cjs --external:electron",
    "build": "pnpm build:main && pnpm build:preload && node scripts/build-runtime.mjs",
    "start": "electron dist/main/index.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@better-me/agent-host": "workspace:*",
    "@better-me/job-service": "workspace:*",
    "better-sqlite3": "13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
