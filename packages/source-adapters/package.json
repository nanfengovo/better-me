{
  "name": "@better-me/source-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./browser-contracts": {
      "types": "./src/browser-contracts.ts",
      "import": "./src/browser-contracts.ts",
      "default": "./dist/browser-contracts.js"
    },
    "./platform-search": {
      "types": "./src/platform-search.ts",
      "import": "./src/platform-search.ts",
      "default": "./dist/platform-search.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@better-me/opportunities": "workspace:*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.8.3"
  }
}
