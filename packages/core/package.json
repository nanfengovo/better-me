{
  "name": "@better-me/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./experience-writing": { "types": "./src/ai/experience-writing.ts", "import": "./src/ai/experience-writing.ts", "default": "./dist/ai/experience-writing.js" },
    "./writing-grounding": { "types": "./src/ai/writing-grounding.ts", "import": "./src/ai/writing-grounding.ts", "default": "./dist/ai/writing-grounding.js" },
    "./resume-writing-method": { "types": "./src/ai/resume-writing-method.ts", "import": "./src/ai/resume-writing-method.ts", "default": "./dist/ai/resume-writing-method.js" },
    "./career-intelligence": { "types": "./src/career-intelligence/index.ts", "import": "./src/career-intelligence/index.ts", "default": "./dist/career-intelligence/index.js" },
    "./resume-business": { "types": "./src/project/resume-business.ts", "import": "./src/project/resume-business.ts", "default": "./dist/project/resume-business.js" },
    "./document": { "types": "./src/schema/document.ts", "import": "./src/schema/document.ts", "default": "./dist/schema/document.js" },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
