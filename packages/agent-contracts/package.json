{
  "name": "@better-me/agent-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    "./career-coach": { "types": "./src/career-coach.ts", "import": "./src/career-coach.ts", "default": "./dist/career-coach.js" },
    "./career-coach-output": { "types": "./src/career-coach-output.ts", "import": "./src/career-coach-output.ts", "default": "./dist/career-coach-output.js" },
    "./career-coach-protocol": { "types": "./src/career-coach-protocol.ts", "import": "./src/career-coach-protocol.ts", "default": "./dist/career-coach-protocol.js" },
    "./career-studio": {
      "types": "./src/career-studio.ts",
      "import": "./src/career-studio.ts",
      "default": "./dist/career-studio.js"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@better-me/core": "workspace:*",
    "hash.js": "1.1.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
